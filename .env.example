# ---- 2braind Landing Factory ----

# Backend
PORT=4005
NODE_ENV=production

# RAG con pgvector (opcional: sin OPENAI_API_KEY usa fallback hash para demo)
DATABASE_URL=postgres://2braind:2braind@landing_pg:5432/2braind
OPENAI_API_KEY=
# Base URL alternativa para OpenAI-compatible (opcional)
# OPENAI_BASE_URL=https://api.openai.com/v1

# Scraper redes sociales (true | false)
SCRAPER_ENABLED=true

# Deploy OpenShip
OPENSHIP_URL=http://164.68.126.30:4100
OPENSHIP_TOKEN=
# Alternativa: INTERNAL_TOKEN (compatibilidad)
# INTERNAL_TOKEN=
# Directorio local para HTML estático si OpenShip API no responde
OPENSHIP_LANDINGS_DIR=/opt/landings
# URL pública donde se sirven las landings estáticas (para og:url / respuesta deploy)
PUBLIC_LANDINGS_BASE=